# Supabase Configuration
# Required for client-side and server-side Supabase client initialization
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (SERVER ONLY - NEVER expose to client)
# Used exclusively for admin tasks, migrations, and system timeline logging
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional Email (Resend)
# Optional in Slice 0, active default for Slice 2 invitations
RESEND_API_KEY=re_your_api_key

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
